{
  "name": "line-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "level:gen": "tsx tools/level-gen.ts",
    "level:audit": "tsx tools/batch-audit.ts",
    "level:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-levels.ps1",
    "level:inspect": "vite --open /tools/level-inspector.html"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "tsx": "^4.16.2",
    "@types/node": "^22.0.0"
  }
}
